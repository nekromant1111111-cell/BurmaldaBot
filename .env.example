# Telegram Bot Token (от BotFather)
BOT_TOKEN=сюда_вставь_токен_бота

# Google Gemini API Key (https://aistudio.google.com/apikey)
LLM_API_KEY=сюда_вставь_ключ_gemini

# Модель Gemini
LLM_MODEL=gemini-2.5-flash

# OpenAI-совместимый endpoint Google
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Максимальная длина истории диалога (в сообщениях)
MAX_HISTORY=20

# Режим вебхука (для продакшна на Render/Railway)
# На локальной машине бот работает через polling
USE_WEBHOOK=False
WEBHOOK_URL=https://ваш-домен.onrender.com
WEBHOOK_PORT=8080
