# Telegram Bot Token (от BotFather)
BOT_TOKEN=сюда_вставь_токен_бота

# OpenRouter API Key (https://openrouter.ai/keys)
LLM_API_KEY=сюда_вставь_ключ_openrouter

# Модель (OpenRouter)
LLM_MODEL=inclusionai/ling-3.0-flash:free
LLM_BASE_URL=https://openrouter.ai/api/v1

# Настройки диалога
MAX_HISTORY=20

# Webhook (для Render — автоопределяется, но можно задать вручную)
USE_WEBHOOK=False
WEBHOOK_URL=https://ваш-домен.onrender.com
WEBHOOK_PORT=8080
